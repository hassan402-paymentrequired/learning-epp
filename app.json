{
  "expo": {
    "name": "Stepra",
    "slug": "stepra",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "src/assets/images/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "stepra",
    "splash": {
      "image": "src/assets/images/logo.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oluwafemiomoope.stepra",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:stepra.com.ng",
        "applinks:www.stepra.com.ng"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "src/assets/images/logo.png"
      },
      "package": "com.oluwafemiomoope.stepra",
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "stepra.com.ng",
              "pathPrefix": "/authenticate/register"
            },
            {
              "scheme": "https",
              "host": "www.stepra.com.ng",
              "pathPrefix": "/authenticate/register"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "src/assets/images/favicon.png"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "translucent": false
    },
    "plugins": [
      "expo-asset",
      "./plugins/withAndroidLegacySplashFullscreen.js",
      [
        "expo-splash-screen",
        {
          "image": "src/assets/images/logo.png",
          "resizeMode": "contain",
          "imageWidth": 220,
          "enableFullScreenImage_legacy": true
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "src/assets/fonts/SpaceMono-Regular.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_400Regular.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_500Medium.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_700Bold.ttf"
          ]
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#4800b2",
          "defaultChannel": "morning-reminders"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2ddba5b9-45bf-4ee4-bc58-9488e7c8e496"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}
